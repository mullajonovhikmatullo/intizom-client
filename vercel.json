{
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/proxy/health"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/proxy/auth/:path*"
    },
    {
      "source": "/todos/:path*",
      "destination": "/api/proxy/todos/:path*"
    },
    {
      "source": "/debts/:path*",
      "destination": "/api/proxy/debts/:path*"
    },
    {
      "source": "/expenses/:path*",
      "destination": "/api/proxy/expenses/:path*"
    },
    {
      "source": "/loans/:path*",
      "destination": "/api/proxy/loans/:path*"
    },
    {
      "source": "/habits/:path*",
      "destination": "/api/proxy/habits/:path*"
    }
  ]
}
